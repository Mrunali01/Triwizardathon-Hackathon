# OpenAI is optional; no key is required for local scans.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_LLM=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional absolute paths; defaults are relative to Backend, not the working directory.
# WCAG_DB_PATH=D:/Triwizardathon-Hackathon/Backend/data/wcag.sqlite
# SCAN_DB_PATH=D:/Triwizardathon-Hackathon/Backend/data/scans.sqlite
# AXE_SCRIPT_PATH=D:/Triwizardathon-Hackathon/Frontend/node_modules/axe-core/axe.min.js
